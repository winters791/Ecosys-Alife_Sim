 // plates sit (BodyPlan, body.hpp).
 float contact_flow(const Phenotype& taker, float pull, const Phenotype& giver, float membrane);
 
+// --- Leaves and grazing (2026-11-12) --------------------------------------------
+// A body's sun patches are its leaves: part of its body, holding the same
+// energy per unit of mass as the rest of it. A mouth can aim part of its pull
+// (the `graze` gene) at the leaves of what it touches instead of at its store.
+// Leaves sit outside the membrane, so only plates facing the grazer resist,
+// and the size rule at the mouth still applies; `bite` does not (it is for
+// draining). What is bitten off feeds the grazer (at its usual efficiency)
+// and its matter falls to the soil under the plant. The plant is not killed:
+// it catches light in proportion to the leaf it has left, and grows the rest
+// back from its own store and the soil in its cell (sim.cpp).
+//
+// LEAF_FLOOR: the share of a leaf nothing can bite off (the part pressed to
+// the skin), so a stripped plant still catches a little light.
+// LEAF_REGROW_TICKS: how long a plant takes to grow a whole leaf back, if it
+// has the energy and the soil; it grows back every 8 ticks while awake.
+constexpr float LEAF_FLOOR        = 0.2f;
+// Energy it takes to build one unit of leaf, and so what a grazer gets for
+// biting it off (the rest of a body costs 222 a unit; phenotype.cpp).
+constexpr float LEAF_ENERGY_PER_MASS = 222.0f;
+constexpr float LEAF_REGROW_TICKS = 1800.0f;   // three days
+
+// Share of its leaf a body still has: 1 = whole, LEAF_FLOOR = grazed bare.
+inline float leaf_left(const Phenotype& p, float bare) {
+    return p.leaf_mass > 0.0f ? std::max(0.0f, 1.0f - bare / p.leaf_mass) : 1.0f;
+}
+// Leaf mass a grazer can still bite off.
+inline float leaf_to_bite(const Phenotype& p, float bare) {
+    return std::max(0.0f, (1.0f - LEAF_FLOOR) * p.leaf_mass - bare);
+}
+// Energy per tick a taker bites off the giver's leaves, given its pull
+// towards the giver and the plates (armour only, no base membrane) facing it.
+float graze_flow(const Phenotype& taker, float pull, const Phenotype& giver, float plates);
+
 // Energy per tick this creature tries to pull out of dead matter in its cell.
 float corpse_demand(const Phenotype& p);
 
