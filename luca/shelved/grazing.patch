+// Grazing: a mouth with the graze gene bites the leaves of what it touches
+// instead of draining its store. The plant lives, catches less light, and
+// grows its leaves back from its store and the soil once left alone.
+void test_grazing() {
+    using namespace luca;
+    {   // Phenotype: leaves are the sun patches' mass; grazing costs upkeep.
+        Genome g = make_luca();
+        g.graze = 1.0f;
+        CHECK(std::abs(compile_phenotype(make_luca()).leaf_mass - 0.1f) < 1e-6f);
+        CHECK(std::abs(compile_phenotype(g).upkeep - compile_phenotype(make_luca()).upkeep - 0.04f) < 1e-4f);
+    }
+    SimConfig cfg = small_config();
+    cfg.nutrient_mean = 0.0f;   // nobody breeds; leaves regrow only from what grazing dropped
+    cfg.windfall_rate = 0.0f;
+    Simulation sim(cfg);
+    Genome grazer_g = with_part(PartType::Absorber, 1.5f);
+    grazer_g.graze = 1.0f;
+    const uint64_t grazer = sim.add_creature(24.2f, 6.0f, 100.0f, aim_east(sim, grazer_g));
+    const uint64_t plant  = sim.add_creature(24.6f, 6.0f, 300.0f, make_luca());
+    const uint64_t loner  = sim.add_creature(40.5f, 6.0f, 300.0f, make_luca());
+    const double matter0 = sim.total_matter();
+    double leaf = 0.0, lost = 0.0;
+    for (int t = 0; t < 40; ++t) {
+        sim.step();
+        leaf += sim.last_stats().eaten_leaf;
+        lost += sim.last_stats().out_transfer;
+    }
+    {
+        const Creatures& c = sim.creatures();
+        const std::size_t ig = find(sim, grazer), ip = find(sim, plant), il = find(sim, loner);
+        CHECK(ig < c.size() && ip < c.size() && il < c.size());
+        if (failures) return;
+        CHECK(leaf > 0.0 && c.fed_leaf[ig] > 0.0f);
+        CHECK(c.fed_living[ig] == 0.0f);                       // it drains nothing
+        CHECK(c.bare[ip] > 0.0f && c.bare[il] == 0.0f);
+        const float left = leaf_left(c.pheno[ip], c.bare[ip]);
+        CHECK(left < 1.0f && left >= LEAF_FLOOR - 1e-4f);      // bitten, never past the floor
+        CHECK(std::abs(lost / (leaf + lost) - (1.0 - TRANSFER_EFFICIENCY)) < 1e-3);
+    }
+    // The grazer has nothing else to live on and starves; the plant grows its
+    // leaves back. The books balance throughout.
+    const double worst = run_audited(sim, 4000);
+    CHECK(worst < 1e-4);
+    CHECK(std::abs(sim.total_matter() - matter0) < 1e-4 * matter0);
+    const Creatures& c = sim.creatures();
+    const std::size_t ip = find(sim, plant);
+    CHECK(find(sim, grazer) == c.size());
+    CHECK(ip < c.size() && c.bare[ip] == 0.0f);
+}
